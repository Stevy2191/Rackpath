# ---------------------------------------------------------------------------
# Rackpath settings. Copy to .env next to docker-compose.yml.
# deploy.sh writes this file for you on a fresh install.
# ---------------------------------------------------------------------------

# Image to run (latest, or a version tag).
IMAGE_TAG=latest
GHCR_NAMESPACE=ghcr.io/stevy2191

# How people reach Rackpath (deploy.sh asks):
#   caddy - HTTPS with Caddy and a self-signed certificate
#   proxy - HTTPS through your own reverse proxy (Nginx Proxy Manager, ...)
#   http  - plain HTTP, for testing only
RACKPATH_HTTPS_MODE=http

# Host port for Rackpath itself. With Caddy it's only reachable from this
# machine; with your own proxy, point the proxy at it.
RACKPATH_PORT=8080
# 0.0.0.0 publishes RACKPATH_PORT on every interface; 127.0.0.1 only on this
# machine (used with Caddy).
RACKPATH_BIND_ADDRESS=0.0.0.0

# Caddy only: COMPOSE_PROFILES=caddy starts it. RACKPATH_HOSTNAME is the name
# or IP address people use, which the certificate is made for.
COMPOSE_PROFILES=
RACKPATH_HOSTNAME=
RACKPATH_HTTPS_PORT=443
RACKPATH_HTTP_PORT=80

# Required: exactly 64 hex characters, from `openssl rand -hex 32`. It
# encrypts the integration logins and API keys you store. Back it up with the
# data volume: without it those secrets must be entered again.
RACKPATH_ENCRYPTION_KEY=

# The address people open Rackpath at, e.g. https://rackpath.example.com.
# Used in invitation links and the QR codes in PDF reports. Leave empty to
# use whatever address each request arrived at.
RACKPATH_PUBLIC_URL=

# Set to true when users reach Rackpath over HTTPS (e.g. behind a TLS reverse
# proxy), so the session cookie is only ever sent over HTTPS.
RACKPATH_COOKIE_SECURE=false

# Set to true behind a reverse proxy that sets X-Forwarded-For, so sign-in
# limits and the change history see the real client address.
RACKPATH_TRUST_PROXY=false

# Delete change history older than this many days (empty: keep forever).
RACKPATH_AUDIT_RETENTION_DAYS=
