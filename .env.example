# ---------------------------------------------------------------------------
# Rackpath environment configuration
# Copy this file to .env and adjust values for your deployment.
#
# Ports: deploy.sh asks for all four during install, so you only need to edit
# them here if you are setting things up by hand or changing a port later.
# After changing any port, apply it with `docker compose up -d`.
#
# Every port below is the HOST port. The ports used inside the compose
# network are fixed and are not configurable, because the frontend image
# bakes in an nginx config that proxies /api/ to rackpath-api:3010.
# ---------------------------------------------------------------------------

# ---- General ----
# Tag/version of the GHCR images to pull (e.g. latest, main, v1.0.0)
IMAGE_TAG=latest
GHCR_NAMESPACE=ghcr.io/stevy2191

# ---- MariaDB (rackpath-db) ----
# deploy.sh replaces the two changeme_* passwords below with random values on
# a fresh install. If you set things up by hand, change them before first
# start: MariaDB only reads them when the data volume is created.
# Root password for the MariaDB container. Only needed for admin tasks
# (e.g. running db/init.sql by hand) - the apps use MYSQL_USER below.
MYSQL_ROOT_PASSWORD=changeme_root_password
# Database name, and the app user/password used to connect to it.
# These three must match DB_NAME/DB_USER/DB_PASSWORD in the API section below.
MYSQL_DATABASE=rackpath
MYSQL_USER=rackpath
MYSQL_PASSWORD=changeme_password
# Host port that maps to MariaDB's port 3306. It is bound to 127.0.0.1 only,
# so it's reachable from this machine (a GUI client over SSH, a backup job)
# but not from the network. The API talks to it over the compose network
# either way. To stop publishing it entirely, delete the "ports:" block from
# rackpath-db in docker-compose.yml.
DB_PORT=3306

# ---- API (rackpath-api) ----
# Host port the API is published on. Inside the compose network the API
# always listens on 3010; only this host-side mapping is configurable.
API_PORT=3010
# Database connection details for the API. DB_HOST is the compose service
# name; DB_PORT_INTERNAL is MariaDB's port *inside* the compose network
# (always 3306, regardless of DB_PORT above). DB_USER/DB_PASSWORD/DB_NAME
# must match the MYSQL_* values above.
DB_HOST=rackpath-db
DB_PORT_INTERNAL=3306
DB_USER=rackpath
DB_PASSWORD=changeme_password
DB_NAME=rackpath

# Secret used to sign authentication JWTs. Generate a long random value, e.g.
# `openssl rand -hex 32`, and keep it secret - anyone with this value can
# forge valid login tokens.
RACKPATH_JWT_SECRET=changeme_use_a_long_random_string

# Shared secret the API and scanner use to authenticate each other (the
# scanner listens on the host network, so without it anyone on the LAN could
# drive scans). Required. Generate with `openssl rand -hex 32`; deploy.sh does
# this for you.
SCANNER_TOKEN=

# Key that encrypts stored credentials (SNMP communities, device, camera and
# integration passwords, API keys). Required: exactly 64 hex characters, from
# `openssl rand -hex 32`; deploy.sh does this for you. Back it up with the
# database - if it's lost or changed, stored credentials can't be decrypted
# and have to be re-entered.
RACKPATH_ENCRYPTION_KEY=

# Browser origins allowed to call the API cross-origin, comma-separated (e.g.
# http://localhost:3000 for frontend development). Leave empty when the UI is
# served by rackpath-frontend, which is same-origin.
CORS_ORIGINS=

# Set to true when users reach Rackpath over HTTPS (e.g. behind a TLS reverse
# proxy) so the session cookie is only ever sent over HTTPS.
COOKIE_SECURE=false

# URL the API uses to reach the scanner service. The port must match
# SCANNER_PORT below.
# rackpath-scanner runs with network_mode: host, so it is not reachable via
# its service name on the default bridge network - use the host gateway
# instead (the api service maps host.docker.internal -> host-gateway).
SCANNER_URL=http://host.docker.internal:5001

# Public base URL the scanner uses to call back into the API with results.
# The port must match API_PORT above. The scanner runs on the host network,
# so it reaches the API through the published host port, not the compose one.
API_PUBLIC_URL=http://localhost:3010

# ---- Frontend (rackpath-frontend) ----
# Host port the web UI is served on - this is the one you open in a browser.
# The container always serves on port 80 behind this mapping.
FRONTEND_PORT=8080
# The frontend calls the API through a relative /api path, which nginx
# proxies inside the compose network, so there is no API URL to configure
# here and no rebuild needed when API_PORT changes.

# ---- Scanner (rackpath-scanner) ----
# The scanner uses host networking, so this is a real port on the host
# rather than a published mapping. Keep SCANNER_URL above in step with it.
SCANNER_PORT=5001
# Default SNMP v2c community string used for discovery
SNMP_COMMUNITY=public
# Default network interface used for scapy/ARP operations (host networking)
SCAN_INTERFACE=eth0
